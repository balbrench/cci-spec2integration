{
  "description": "Pipeline stage dependency map: the single source of truth for which command produces each stage, which files are its artifact, and which upstream files make it stale. Read by scripts/refresh-status.ps1 and by the VS Code extension (src/stageMap.ts). Paths are relative to the integration folder; repoUpstream paths are relative to the repo root.",
  "staleness": "A stage whose status is 'done' becomes 'stale' when any upstream (or repoUpstream) path has a newer mtime than the newest of its artifact paths. A directory's mtime is the newest file beneath it. Stages are checked in this order, and the first stale one drives 'next'. '{platform}' in a command is replaced by the active platform pack.",
  "stages": [
    { "id": "1",  "command": "/specify",            "artifact": ["spec.md"], "repoUpstream": ["specs/PRD.md"], "greenfieldOnly": true },
    { "id": "1a", "command": "/clarify" },
    { "id": "2",  "command": "/model",              "artifact": ["data-model.md"],                                              "upstream": ["spec.md"] },
    { "id": "3",  "command": "/contracts",          "artifact": ["contracts/openapi.yaml", "contracts/asyncapi.yaml", "contracts/schemas"], "upstream": ["spec.md", "data-model.md"] },
    { "id": "3a", "command": "/contracts",          "artifact": ["contract-lint-report.json"],                                  "upstream": ["contracts/openapi.yaml", "contracts/asyncapi.yaml", "contracts/schemas"] },
    { "id": "4",  "command": "/map",                "artifact": ["mappings"],                                                   "upstream": ["spec.md", "data-model.md", "contracts"] },
    { "id": "5",  "command": "/architect",          "artifact": ["integration-ir.yaml"],                                        "upstream": ["spec.md", "data-model.md", "contracts", "mappings"] },
    { "id": "5a", "command": "/review",             "artifact": ["ir-validation-report.json"],                                  "upstream": ["integration-ir.yaml"] },
    { "id": "5b", "command": "/review",             "artifact": ["stm-drift-report.json"],                                      "upstream": ["integration-ir.yaml", "mappings"] },
    { "id": "5c", "command": "/review",             "artifact": ["secret-scan-report.json"],                                    "upstream": ["integration-ir.yaml"] },
    { "id": "5d", "command": "/review",             "artifact": ["pii-flow-report.json"],                                       "upstream": ["integration-ir.yaml"] },
    { "id": "5e", "command": "/review",             "artifact": ["review-report.json"],                                         "upstream": ["spec.md", "data-model.md", "contracts", "mappings", "integration-ir.yaml"] },
    { "id": "6",  "command": "/test-mappings",      "artifact": ["mapping-test-report.json"],                                   "upstream": ["integration-ir.yaml", "mappings"] },
    { "id": "6a", "command": "/test-flows",         "artifact": ["flow-test-report.json"],                                      "upstream": ["integration-ir.yaml"] },
    { "id": "7",  "command": "/platform" },
    { "id": "8",  "command": "/plan",               "artifact": ["plan.md"],                                                    "upstream": ["spec.md", "data-model.md", "contracts", "mappings", "integration-ir.yaml"] },
    { "id": "9",  "command": "/tasks",              "artifact": ["tasks.md"],                                                   "upstream": ["plan.md", "integration-ir.yaml"] },
    { "id": "10", "command": "/implement-{platform}", "artifact": ["app", "FunctionApps", "adf"],                               "upstream": ["tasks.md", "integration-ir.yaml"] },
    { "id": "11", "command": "/test-{platform}",    "artifact": ["tests-mstest"],                                               "upstream": ["tasks.md", "integration-ir.yaml"] },
    { "id": "12", "command": "/deploy-{platform}" }
  ]
}
